{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "sin1"
  ],
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/admin/:file",
      "destination": "/api/admin?f=:file"
    },
    {
      "source": "/api/ads",
      "destination": "/ads-list.json"
    },
    {
      "source": "/api/wa-status/:key",
      "destination": "/api/wa-status?key=:key"
    },
    {
      "source": "/api/board",
      "destination": "/api/time?board=1"
    },
    {
      "source": "/api/wa-kick",
      "destination": "/api/wa-retry?kick=1"
    }
  ],
  "functions": {
    "api/admin.js": {
      "includeFiles": "private/**"
    },
    "api/action.js": {
      "maxDuration": 60
    },
    "api/wa-retry.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/ads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
